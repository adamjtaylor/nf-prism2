/*
 * nf-prism2 pipeline configuration
 */

manifest {
    name            = 'nf-prism2'
    author          = 'Adam Taylor'
    description     = 'OpenSlide WSI -> Virchow2 (class token) -> PRISM2 slide embeddings, yes/no scores, Q&A and report'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.10.0'   // nf-synapse plugin requires 25.10+
    version         = '1.0.0'
}

// syn:// paths in the samplesheet, staged with their original Synapse filename.
// Needs a SYNAPSE_AUTH_TOKEN secret (Nextflow secret locally, workspace secret on Seqera).
plugins {
    id 'nf-synapse@0.1.3'
}

params {
    // input / output
    input             = null            // samplesheet: sample,slide[,mpp]
    outdir            = 'results'
    questions         = "${projectDir}/assets/questions.yaml"
    help              = false

    // tiling / tile encoder  (PRISM2 requires 224 px @ 20x, class-token Virchow2)
    mag               = 20
    patch_size        = 224
    segmenter         = 'hest'          // hest | grandqc | otsu
    seg_conf_thresh   = 0.5
    remove_artifacts  = false
    remove_penmarks   = false
    remove_holes      = false
    tile_batch_size   = 32
    reader_type       = null            // openslide | image | cucim | sdpc | omezarr | czi

    // PRISM2 inference
    // 0 = use every tile. PRISM2's processor compresses any tile count to num_img_tokens=256,
    // so inference is constant-cost in N: subsampling saves nothing and only loses information.
    // Set a cap only as an out-of-memory guard on very large slides.
    max_tiles         = 0
    max_new_tokens    = 100
    seed              = 42              // only used when max_tiles > 0 forces a subsample
    save_embeddings   = true
    scoring_dtype     = 'bf16'          // 'fp32' for quantitative yes/no scoring, see docs
    // pin the gated repo revision: it ships trust_remote_code files that can change
    prism2_revision   = '450352d0ddc6b42b21ce20794ce0fbefe6b5a47a'

    // model weights
    hf_cache          = null            // pre-staged HF cache dir (skips STAGE_MODELS)
    hf_repos_extra    = 'MahmoodLab/hest-tissue-seg'   // segmenter weights; comma-separated, best-effort
    hf_token_secret   = 'HF_TOKEN'      // name of the Nextflow/Seqera secret holding the HF token

    // execution
    gpu_queue         = null            // AWS Batch GPU queue (awsbatch profile)
    cpu_only          = false           // drop `accelerator 1` requests (CPU-queue smoke tests)
    publish_dir_mode  = 'copy'
}

includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
    }
    docker_gpu {
        docker.enabled         = true
        docker.runOptions      = '--gpus all'
        singularity.enabled    = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = '--nv'
        docker.enabled         = false
    }
    local {
        // Caps the label resources down to a laptop/workstation so -stub and small
        // single-slide runs are not rejected by the local executor.
        executor.name          = 'local'
        process.resourceLimits = [ cpus: 4, memory: 8.GB, time: 8.h ]
    }
    awsbatch     { includeConfig 'conf/awsbatch.config' }
    test         { includeConfig 'conf/test.config'     }
}

// Sensible defaults everywhere
process.shell = ['/bin/bash', '-euo', 'pipefail']

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"  ; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html"    ; overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt"      ; overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html"       ; overwrite = true }

// Completion message (kept in config: DSL2 strict syntax disallows top-level statements in main.nf)
workflow.onComplete = {
    println(workflow.success
        ? "\nDone. Results: ${params.outdir}/results.tsv"
        : "\nFailed: ${workflow.errorMessage}")
}
