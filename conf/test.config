/*
 * Minimal smoke-test profile.
 *
 *   nextflow run . -profile test,docker -stub          # wiring only, no GPU needed
 *   nextflow run . -profile test,docker_gpu            # real single-slide run on a GPU box
 *   nextflow run . -profile test,awsbatch --outdir s3://bucket/test --gpu_queue <q>
 *
 * Uses the public OpenSlide test slide (Aperio CMU-1.svs, ~170 MB).
 */

params {
    input          = "${projectDir}/assets/samplesheet_test.csv"
    questions      = "${projectDir}/assets/questions_test.yaml"
    max_new_tokens = 32
    // no max_tiles cap: CMU-1's 6,182 tiles peak at 8.8 GB VRAM, and capping would not
    // make the run faster because PRISM2 is constant-cost in tile count
    segmenter      = 'otsu'    // no extra weights to download
}
