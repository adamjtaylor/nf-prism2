/*
 * Resource labels and container images.
 *
 * Build the two images from containers/*.Dockerfile and push them to a registry the
 * compute environment can pull from (ECR in the same region as the Batch queue).
 * Referencing by digest (@sha256:...) is strongly preferred for reproducibility.
 */

params {
    container_trident = 'ghcr.io/adamjtaylor/nf-prism2-trident:1.0.0'
    container_prism2  = 'ghcr.io/adamjtaylor/nf-prism2-prism2:1.0.0'
    container_python  = 'python:3.12'          // not -slim: needs procps for Nextflow task metrics
}

process {
    // Default for the pipeline's shared steps: a failure here is fatal and should stop the run.
    errorStrategy = { task.exitStatus in params.retry_exit_codes && task.attempt <= task.maxRetries ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_low {
        container = params.container_python
        cpus      = 2
        memory    = { 6.GB  * task.attempt }
        time      = { 2.h   * task.attempt }
    }

    // Per-slide work. After retries are exhausted, drop the slide instead of killing the run:
    // in a 2,165-slide cohort one unreadable file must not lose the other 2,164. The dropped
    // samples are listed in failed_samples.txt. Set --ignore_failed_slides false to stop instead.
    withLabel: 'gpu_small|gpu_large' {
        errorStrategy = { task.exitStatus in params.retry_exit_codes && task.attempt <= task.maxRetries ? 'retry'
                          : (params.ignore_failed_slides ? 'ignore' : 'finish') }
    }

    // Exit 1 from the tile pass is worth exactly one more go, because the commonest cause is
    // TRIDENT picking the wrong reader from the file extension, which --retry_reader fixes on
    // the second attempt. Genuinely broken files cost one wasted slot, which is cheap next to
    // curating a reader column for a whole cohort.
    withName: TRIDENT_EMBED {
        errorStrategy = { (task.exitStatus in params.retry_exit_codes || task.exitStatus == 1) && task.attempt <= task.maxRetries ? 'retry'
                          : (params.ignore_failed_slides ? 'ignore' : 'finish') }
    }

    // Virchow2 tile embedding: modest VRAM, IO/GPU bound, scales with slide size
    withLabel: gpu_small {
        container   = params.container_trident
        // closure so `--cpu_only true` can drop the GPU request for CPU-queue smoke tests
        accelerator = { params.cpu_only ? null : 1 }
        // DataLoader workers need real /dev/shm; the 64 MB container default gives
        // "DataLoader worker killed by signal: Bus error" during segmentation
        containerOptions = '--shm-size 8g'
        cpus        = 8
        memory      = { 24.GB * task.attempt }
        time        = { 8.h   * task.attempt }
    }

    // PRISM2 = 4.4B params in bf16 + up to max_tiles x 1280 tile embeddings.
    // Needs >= 24 GB VRAM (g5.2xlarge / A10G or better).
    withLabel: gpu_large {
        container   = params.container_prism2
        accelerator = { params.cpu_only ? null : 1 }
        // DataLoader workers need real /dev/shm; the 64 MB container default gives
        // "DataLoader worker killed by signal: Bus error" during segmentation
        containerOptions = '--shm-size 8g'
        cpus        = 8
        memory      = { 24.GB * task.attempt }
        time        = { 4.h   * task.attempt }
    }

    withName: STAGE_MODELS {
        container = params.container_prism2
        cpus      = 4
        memory    = { 8.GB * task.attempt }
        time      = { 4.h  * task.attempt }
    }
}
