/*
 * AWS Batch execution.
 *
 * On Seqera Platform the compute environment already supplies the executor, queue,
 * work directory, region and Fusion settings, so most of this is a no-op there and
 * only `gpu_queue` normally needs setting (Advanced options -> Pipeline parameters).
 * Keep this profile for plain CLI runs against AWS Batch.
 */

params {
    queue     = null    // CPU Batch queue
    aws_region = 'us-east-1'
}

process {
    executor = 'awsbatch'
    queue    = { params.queue }

    // Route GPU steps to a GPU-enabled queue (ECS GPU AMI) if one is given
    withLabel: gpu_small { queue = { params.gpu_queue ?: params.queue } }
    withLabel: gpu_large { queue = { params.gpu_queue ?: params.queue } }
}

aws {
    region = params.aws_region
    batch {
        maxParallelTransfers = 8
        maxTransferAttempts  = 3
        delayBetweenAttempts = '30 sec'
    }
    client {
        maxConnections   = 20
        connectionTimeout = 60000
    }
}

// Stream whole-slide images straight from S3 instead of full-copying them
fusion.enabled = true
wave.enabled   = true
